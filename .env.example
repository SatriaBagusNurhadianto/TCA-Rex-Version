# TCA-Rex-Version Configuration

# Target Configuration
TARGET_TIMEOUT=10000
MAX_RETRIES=3

# Scanning Options
CONCURRENT_REQUESTS=10
RATE_LIMIT_DELAY=100
RANDOMIZE_DELAY=true

# WAF Detection & Bypass
WAF_DETECTION_ENABLED=true
WAF_BYPASS_ENABLED=true
ENCODING_METHODS=hex,url,unicode,base64

# Logging
LOG_LEVEL=info
LOG_FILE=logs/tca-rex.log

# Output
OUTPUT_FORMAT=json
REPORT_TEMPLATE=detailed

# Proxy (Optional)
PROXY_ENABLED=false
PROXY_URL=http://localhost:8080

# Headers
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
REFERER_RANDOMIZE=true
